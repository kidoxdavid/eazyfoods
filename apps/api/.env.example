NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/eazyfoods_dev
WEB_ORIGIN=http://localhost:5173
SESSION_DAYS=30

# Payments. mock = development only. stripe or helcim for real money (see docs/PAYMENTS.md).
PAYMENT_PROVIDER=mock
# Stripe (only when PAYMENT_PROVIDER=stripe). Use test keys first.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Helcim (only when PAYMENT_PROVIDER=helcim). Keep these secret; never commit real values.
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_VERIFIER=
HELCIM_REFUND_IP=

