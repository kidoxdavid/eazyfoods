# API base URL. Leave unset for local dev (Vite proxy to localhost:8000).
# For production (e.g. Vercel), set to your Render backend:
# VITE_API_BASE_URL=https://eazyfoods-api.onrender.com/api/v1

# Optional: Google OAuth (customer login with Google)
# VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: Google Maps API key (enables Places Autocomplete on checkout address field
# and sends exact lat/lng to backend — eliminates geocoding failures for delivery fee)
# VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key

# Optional: Driver signup URL for Get Started banner (e.g. https://delivery.eazyfoods.ca)
# VITE_DRIVER_SIGNUP_URL=https://delivery.eazyfoods.ca
