# Android app build environment
# IMPORTANT: set VITE_API_BASE_URL to your live backend before building
VITE_API_BASE_URL=https://eazyfoods-api.onrender.com/api/v1

# Google OAuth (optional — used for Sign in with Google)
# VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Maps (used on delivery/address screens)
# VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key
